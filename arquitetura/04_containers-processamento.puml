@startuml 04_containers-processamento
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title FIAP X — Containers (Processamento)

Container(bff, "BFF Consultas", ".NET", "Progresso, cancelamento, URL do zip")
Container(procApi, "Processamento API", ".NET", "Progresso, cancelamento, URL zip")
Container(procWorker, "Processamento Worker", ".NET + FFmpeg", "Extração, zip, checkpoint, status")
ContainerDb(pgProc, "Postgres Processamento", "PostgreSQL", "Job, progresso canônico, checkpoint")
ContainerDb(frioProc, "Storage frio Processamento", "Object storage", "Frames e zip")
ContainerQueue(pubsub, "Pub/Sub", "Mensageria", "Handoff, status, cancelamento")

Rel(bff, procApi, "Progresso / cancelamento / URL zip", "HTTPS")
Rel(procApi, pgProc, "Lê/escreve", "SQL")
Rel(procApi, pubsub, "Publica cancelamento-solicitado")
Rel(procWorker, pgProc, "Checkpoint / progresso", "SQL")
Rel(procWorker, pubsub, "Consome handoff/cancel; publica status")
Rel(procWorker, frioProc, "Frames e zip", "HTTPS")

Lay_D(bff, procApi)
Lay_R(procApi, procWorker)
Lay_D(procApi, pgProc)
Lay_D(procWorker, frioProc)
Lay_R(procWorker, pubsub)

@enduml
