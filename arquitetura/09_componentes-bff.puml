@startuml 09_componentes-bff
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title bff — Componentes

Container(web, "Front", "SPA estática", "Cliente HTTPS")
Container(auth, "autenticacao", ".NET", "JWKS / login")
Container(upload, "upload", ".NET", "Upload, listagem, thumbs, status, cancelamento")
Container(procApi, "processamento-api", ".NET", "Progresso, URL do zip")
ContainerDb(redis, "Redis bff", "Redis", "Cache-aside de progresso")

Container_Boundary(bff, "bff") {
  Component(gateway, "API pública", ".NET", "Única janela HTTP de produto")
  Component(agg, "Agregação", ".NET", "Orquestra auth, upload, processamento e cache")
}

Rel(web, gateway, "Usa", "HTTPS/JSON")
Rel(gateway, agg, "Delega")
Rel(agg, auth, "Login / JWT", "HTTPS")
Rel(agg, upload, "Upload / lista / thumb / cancelamento", "HTTPS")
Rel(agg, procApi, "Progresso / URL zip", "HTTPS")
Rel(agg, redis, "Cache-aside", "TCP")

Lay_D(web, gateway)
Lay_D(gateway, agg)
Lay_D(agg, redis)
Lay_R(auth, upload)
Lay_R(upload, procApi)
Lay_D(agg, auth)

@enduml
