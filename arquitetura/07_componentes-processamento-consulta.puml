@startuml 07_componentes-processamento-consulta
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title processamento-api — Consulta de progresso

Container(bff, "bff", ".NET", "Lista em upload; progresso em processamento-api")
Container(upload, "upload", ".NET", "Projeção de status e thumb")
ContainerDb(redis, "Redis bff", "Redis", "Cache-aside de progresso")
ContainerDb(pgProc, "Postgres processamento", "PostgreSQL", "Progresso canônico")

Container_Boundary(procApi, "processamento-api") {
  Component(apiHttp, "API HTTP", ".NET", "Progresso, URL zip, frame para thumb")
  Component(consulta, "Consulta progresso", ".NET", "Lê progresso canônico")
  Component(frameThumb, "Frame para thumb", ".NET", "Qualquer frame válido no frio")
}

ContainerDb(frioProc, "Frio processamento", "Object storage", "Frames")

Rel(bff, upload, "Listagem paginada / thumb", "HTTPS")
Rel(bff, redis, "Cache-aside", "TCP")
Rel(bff, apiHttp, "Progresso / URL zip", "HTTPS")
Rel(upload, apiHttp, "GET frame (thumb)", "HTTPS")
Rel(apiHttp, consulta, "Usa")
Rel(apiHttp, frameThumb, "Usa")
Rel(consulta, pgProc, "Lê", "SQL")
Rel(frameThumb, frioProc, "Lê frame", "HTTPS")

Lay_D(bff, redis)
Lay_R(bff, upload)
Lay_R(bff, apiHttp)
Lay_D(apiHttp, consulta)
Lay_D(consulta, pgProc)
Lay_R(apiHttp, frameThumb)
Lay_D(frameThumb, frioProc)

@enduml
