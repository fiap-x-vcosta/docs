@startuml 05_containers-notificacao
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()

title FIAP X — Containers (notificacao)

ContainerQueue(pubsub, "Pub/Sub", "Mensageria", "Eventos de domínio")
Container(notif, "notificacao", ".NET", "Consome eventos e envia e-mail")
Container(auth, "autenticacao", ".NET", "E-mail por userId")
ContainerDb(pgNotif, "Postgres notificacao", "PostgreSQL", "Inbox / outbox de e-mail")
System_Ext(sendgrid, "SendGrid", "E-mail")

Rel(pubsub, notif, "Entrega upload-video-atualizado / processamento-video-atualizado")
Rel(notif, auth, "Consulta e-mail", "HTTPS")
Rel(notif, pgNotif, "Inbox / outbox", "SQL")
Rel(notif, sendgrid, "Envia e-mail", "HTTPS")

Lay_R(pubsub, notif)
Lay_R(notif, sendgrid)
Lay_D(notif, pgNotif)
Lay_D(notif, auth)

@enduml
