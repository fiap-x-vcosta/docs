@startuml 03_containers-upload
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title FIAP X — Containers (Upload)

Container(bff, "BFF Consultas", ".NET", "Encaminha upload, triagem e thumbs")
Container(upload, "Upload", ".NET", "Triagem, original, thumbs de catálogo")
ContainerDb(pgUpload, "Postgres Upload", "PostgreSQL", "Metadados de upload/triagem")
ContainerDb(frioUp, "Storage frio Upload", "Object storage", "Vídeo original")
ContainerDb(quente, "Storage quente Upload", "Object storage", "Thumbs de listagem")
ContainerQueue(pubsub, "Pub/Sub", "Mensageria", "Eventos de domínio + DLQ")

Rel(bff, upload, "Upload / triagem / thumb", "HTTPS")
Rel(upload, pgUpload, "Lê/escreve", "SQL")
Rel(upload, frioUp, "Grava/remove original", "HTTPS")
Rel(upload, quente, "Grava/serve thumbs", "HTTPS")
Rel(upload, pubsub, "Publica + URL de leitura")
Rel(pubsub, upload, "Consome thumb / remoção")

Lay_D(bff, upload)
Lay_D(upload, pgUpload)
Lay_R(pgUpload, frioUp)
Lay_R(frioUp, quente)
Lay_R(quente, pubsub)

@enduml
