@startuml 03_containers-upload
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title FIAP X — Containers (upload)

Container(bff, "bff", ".NET", "Upload, listagem paginada, thumbs, cancelamento")
Container(upload, "upload", ".NET", "Triagem, original, projeção de status, thumbs")
ContainerDb(pgUpload, "Postgres upload", "PostgreSQL", "Catálogo, status projetado, outbox")
ContainerDb(frioUp, "Storage frio upload", "Object storage", "Vídeo original")
ContainerDb(quente, "Storage quente upload", "Object storage", "Thumbs de listagem")
ContainerQueue(pubsub, "Pub/Sub", "Mensageria", "Eventos de domínio + DLQ")

Rel(bff, upload, "Upload / lista / thumb / cancelamento", "HTTPS")
Rel(upload, pgUpload, "Lê/escreve", "SQL")
Rel(upload, frioUp, "Grava/remove original", "HTTPS")
Rel(upload, quente, "Grava/serve thumbs", "HTTPS")
Rel(upload, pubsub, "Publica upload-video-atualizado")
Rel(pubsub, upload, "Consome processamento-video-atualizado")

Lay_D(bff, upload)
Lay_D(upload, pgUpload)
Lay_R(pgUpload, frioUp)
Lay_R(frioUp, quente)
Lay_R(quente, pubsub)

@enduml
